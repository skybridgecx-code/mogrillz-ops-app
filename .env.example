# Explicit local portfolio/demo mode.
# Production deployments should set this to false and configure Supabase below.
NEXT_PUBLIC_USE_MOCK_DATA=true

# Supabase browser-safe configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only privileged configuration. Never expose this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
MOGRILLZ_MENU_IMAGE_BUCKET=menu-images
