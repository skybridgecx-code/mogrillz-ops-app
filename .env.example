# Explicit local portfolio/demo mode.
# Production deployments must set this to false and configure Supabase below.
NEXT_PUBLIC_USE_MOCK_DATA=true

# Supabase browser-safe configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional browser-visible HTTPS links. Leave blank to hide the sidebar links.
NEXT_PUBLIC_SHAMAS_KITCHEN_SITE_URL=
NEXT_PUBLIC_SHAMAS_KITCHEN_SOCIAL_AGENT_URL=

# Server-only privileged configuration. Never expose this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
MOGRILLZ_MENU_IMAGE_BUCKET=menu-images

# Optional bounded dashboard history controls.
MOGRILLZ_OPS_ORDER_HISTORY_LIMIT=500
MOGRILLZ_OPS_CUSTOMER_LIMIT=1000
MOGRILLZ_OPS_SUBSCRIBER_LIMIT=1000
MOGRILLZ_OPS_INSIGHT_LIMIT=50

# Optional admin-membership schema overrides. Defaults match supabase/schema.sql.
MO_GRILLZ_ADMIN_MEMBERSHIP_TABLE=admin_memberships
MO_GRILLZ_ADMIN_MEMBERSHIP_USER_ID_COLUMN=user_id
MO_GRILLZ_ADMIN_MEMBERSHIP_ROLE_COLUMN=role
MO_GRILLZ_ADMIN_MEMBERSHIP_ACTIVE_COLUMN=is_active
MO_GRILLZ_ADMIN_MEMBERSHIP_ALLOWED_ROLES=owner,admin
